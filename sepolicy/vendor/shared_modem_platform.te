type modem_stat_data_file, data_file_type, file_type;
type shared_modem_platform, domain;
type shared_modem_platform_exec, exec_type, file_type, vendor_file_type;

dump_hal(hal_shared_modem_platform)

hal_server_domain(shared_modem_platform, hal_shared_modem_platform)

hal_attribute_service(hal_shared_modem_platform, hal_shared_modem_platform_service)

init_daemon_domain(shared_modem_platform)

perfetto_producer(shared_modem_platform)

set_prop(shared_modem_platform, vendor_audio_prop)
set_prop(shared_modem_platform, vendor_modem_info_prop)
set_prop(shared_modem_platform, vendor_modem_prop)
set_prop(shared_modem_platform, vendor_mtk_radio_prop)
set_prop(shared_modem_platform, vendor_tcpdump_log_prop)

use_keystore(shared_modem_platform)

allow shared_modem_platform keystore:keystore2_key { get_info rebind use };
allow shared_modem_platform mnt_vendor_file:dir search;
allow shared_modem_platform modem_stat_data_file:dir rw_dir_perms;
allow shared_modem_platform modem_stat_data_file:file create_file_perms;
allow shared_modem_platform mtk_wwan_device:chr_file rw_file_perms;
allow shared_modem_platform pixel_modem_app:dir search;
allow shared_modem_platform pixel_modem_app:file { getattr open read };
allow shared_modem_platform radio_device:chr_file rw_file_perms;
allow shared_modem_platform radio_vendor_data_file:dir rw_dir_perms;
allow shared_modem_platform radio_vendor_data_file:file create_file_perms;
allow shared_modem_platform radio_vendor_data_file:sock_file { create unlink write };
allow shared_modem_platform self:netlink_kobject_uevent_socket { bind create read setopt };
allow shared_modem_platform sysfs_kernel_metrics:file r_file_perms;
allow shared_modem_platform sysfs_modem:file r_file_perms;
allow shared_modem_platform vendor_pms_data_file:dir { getattr open read remove_name search write };
allow shared_modem_platform vendor_pms_data_file:file { getattr open read unlink };

allowxperm shared_modem_platform radio_device:chr_file ioctl { 0x7501-0x7504 };

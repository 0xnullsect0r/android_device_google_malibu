type gnss_daemon, domain;
type gnss_daemon_exec, exec_type, file_type, vendor_file_type;

binder_call(gnss_daemon, gnss_manager)
binder_call(gnss_daemon, servicemanager)
binder_call(gnss_daemon, system_server)

get_prop(gnss_daemon, vendor_gps_prop)
get_prop(gnss_daemon, vendor_mtk_radio_prop)

init_daemon_domain(gnss_daemon)

allow gnss_daemon fwk_sensor_service:service_manager find;
allow gnss_daemon gnss_manager_service:service_manager find;
allow gnss_daemon hal_gnss_default:unix_dgram_socket sendto;
allow gnss_daemon init:unix_stream_socket connectto;
allow gnss_daemon mtk_wwan_device:chr_file { open read write };
allow gnss_daemon node:tcp_socket node_bind;
allow gnss_daemon port:tcp_socket name_bind;
allow gnss_daemon property_socket:sock_file write;
allow gnss_daemon self:netlink_kobject_uevent_socket { bind create read setopt };
allow gnss_daemon self:tcp_socket { accept bind create listen setopt };
allow gnss_daemon sscoredump_device:chr_file rw_file_perms;
allow gnss_daemon vendor_gps_file:dir { add_name create getattr open read remove_name search setattr write };
allow gnss_daemon vendor_gps_file:file { append create getattr open read rename setattr unlink write };
allow gnss_daemon vendor_gps_prop:property_service set;

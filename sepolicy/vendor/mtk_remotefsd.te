type mtk_remotefsd, domain;
type mtk_remotefsd_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(mtk_remotefsd)

allow mtk_remotefsd mtk_wwan_device:chr_file rw_file_perms;
allow mtk_remotefsd radio_vendor_data_file:dir create_dir_perms;
allow mtk_remotefsd radio_vendor_data_file:file create_file_perms;
allow mtk_remotefsd self:netlink_kobject_uevent_socket { bind create read setopt };
allow mtk_remotefsd vendor_gps_file:dir create_dir_perms;
allow mtk_remotefsd vendor_gps_file:file create_file_perms;

dontaudit mtk_remotefsd self:capability net_admin;

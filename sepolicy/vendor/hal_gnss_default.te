add_service(hal_gnss_default, hal_lbs_service)

binder_call(hal_gnss_default, gnss_manager)

get_prop(hal_gnss_default, vendor_gps_prop)

allow hal_gnss_default gnss_daemon:unix_dgram_socket sendto;
allow hal_gnss_default gnss_manager_service:service_manager find;
allow hal_gnss_default hal_vendor_lbs_external_service:service_manager find;
allow hal_gnss_default lbs_service:binder { call transfer };
allow hal_gnss_default self:capability2 wake_alarm;
allow hal_gnss_default sscoredump_device:chr_file rw_file_perms;
allow hal_gnss_default vendor_gps_file:dir { add_name search write };
allow hal_gnss_default vendor_gps_file:file { create getattr open read write };

add_service(rild, hal_ril_ext_service)
add_service(rild, hal_vendor_radio_external_service)

binder_call(rild, hal_audio_default)
binder_call(rild, mtk_hal_secure_element)
binder_call(rild, rilextensionservice_app)
binder_call(rild, vendor_satellite_service)

crash_dump_fallback(rild)

domain_auto_trans(rild, netutils_wrapper_exec, netutils_wrapper)

get_prop(rild, sota_prop)
get_prop(rild, telephony_ntn_demo_mode_prop)
get_prop(rild, telephony_ril_ntn_sim_deact_prop)
get_prop(rild, vendor_audio_prop)
get_prop(rild, vendor_modem_prop)

set_prop(rild, ims_prop)
set_prop(rild, system_ril_ext_prop)
set_prop(rild, vendor_mtk_cdma_prop)
set_prop(rild, vendor_mtk_ims_config_prop)
set_prop(rild, vendor_mtk_ims_eims_pdn_prop)
set_prop(rild, vendor_mtk_ims_prop)
set_prop(rild, vendor_mtk_radio_prop)
set_prop(rild, vendor_mtk_ril_vote_prop)
set_prop(rild, vendor_mtk_ss_vendor_prop)

vndbinder_use(rild)

allow rild hal_audio_ext_service:service_manager find;
allow rild mtk_wwan_device:chr_file rw_file_perms;
allow rild proc_net:file write;
allow rild sysfs_modem:file rw_file_perms;

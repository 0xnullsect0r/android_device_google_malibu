binder_call(hal_health_default, hal_wlcservice)
binder_call(hal_health_default, stats_service_server)

r_dir_file(hal_health_default, sysfs_scsi_devices_0000)

set_prop(hal_health_default, vendor_battery_defender_prop)
set_prop(hal_health_default, vendor_battery_fg_prop)

allow hal_health_default mnt_vendor_file:dir search;
allow hal_health_default persist_battery_file:dir search;
allow hal_health_default persist_battery_file:file rw_file_perms;
allow hal_health_default persist_file:dir search;
allow hal_health_default sysfs_batteryinfo:file rw_file_perms;
allow hal_health_default sysfs_charger_chip:dir search;
allow hal_health_default sysfs_charger_chip:file rw_file_perms;
allow hal_health_default sysfs_gcdd_dev_stat:file rw_file_perms;
allow hal_health_default sysfs_typec:dir { open read search };
allow hal_health_default sysfs_wlc:dir search;

app_domain(pixeldisplayservice_app)

typeattribute pixeldisplayservice_app coredomain;

binder_use(pixeldisplayservice_app)

allow pixeldisplayservice_app activity_service:service_manager find;
allow pixeldisplayservice_app activity_task_service:service_manager find;
allow pixeldisplayservice_app audio_service:service_manager find;
allow pixeldisplayservice_app cameraserver_service:service_manager find;
allow pixeldisplayservice_app color_display_service:service_manager find;
allow pixeldisplayservice_app device_state_service:service_manager find;
allow pixeldisplayservice_app fwk_stats_service:service_manager find;
allow pixeldisplayservice_app gpu_service:service_manager find;
allow pixeldisplayservice_app hint_service:service_manager find;
allow pixeldisplayservice_app netstats_service:service_manager find;
allow pixeldisplayservice_app protolog_configuration_service:service_manager find;
allow pixeldisplayservice_app sensitive_content_protection_service:service_manager find;
allow pixeldisplayservice_app sensorservice_service:service_manager find;
allow pixeldisplayservice_app thermal_service:service_manager find;
allow pixeldisplayservice_app virtual_device_native_service:service_manager find;
